{
  // Prettier owns wrapping and list/emphasis style; disable the rules that
  // would fight it or the stored prompts.
  "default": true,
  "MD013": false, // line length — prose, and prettier preserves wrapping
  "MD024": { "siblings_only": true }, // repeated headings across sections are fine
  "MD033": false, // inline HTML — managed-section markers and prompt tokens (<system-reminder>, …)
  "MD041": false, // first line need not be an H1 (PR template opens with a comment)
}
